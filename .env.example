# Appwrite project that owns Recall (the OAuth2 server lives inside it).
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<PROJECT_ID>
# API key with sessions.write, users.read, apps.read, databases.read,
# collections.read, documents.read, documents.write, embeddings.write
APPWRITE_API_KEY=<API_KEY>
# Any long random string, used to sign Recall's own session cookie.
SESSION_SECRET=<A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS>
